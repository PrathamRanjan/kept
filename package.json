{
  "name": "kept",
  "version": "0.1.0",
  "private": true,
  "description": "Kept: PayPal subscriptions that AI agents can manage, with fair retention for small subscription businesses.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "worker": "node --env-file-if-exists=.env dist/worker-main.js",
    "cron": "node --env-file-if-exists=.env dist/cron-main.js",
    "build": "npm run build:web && tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix web run typecheck",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "sandbox:check": "tsx --env-file-if-exists=.env scripts/pp-check.mts",
    "agent:demo": "tsx --env-file-if-exists=.env scripts/buyer-agent.ts",
    "webhook:register": "tsx --env-file-if-exists=.env scripts/register-webhook.ts",
    "eval:reasons": "tsx --env-file-if-exists=.env scripts/eval-reasons.ts",
    "eval:adversarial": "tsx --env-file-if-exists=.env scripts/eval-adversarial.ts",
    "eval:b5": "tsx --env-file-if-exists=.env scripts/eval-b5.ts",
    "cli": "tsx --env-file-if-exists=.env scripts/kept-cli.ts",
    "build:web": "npm --prefix web ci --include=dev && npm --prefix web run build",
    "e2e": "playwright test",
    "shots": "node scripts/shots.mjs",
    "calibrate": "tsx --env-file-if-exists=.env scripts/calibrate.ts",
    "eval:fairness": "tsx --env-file-if-exists=.env scripts/eval-fairness.ts",
    "eval:exchange": "tsx --env-file-if-exists=.env scripts/eval-exchange.ts",
    "robot:judge": "playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/qrcode": "^1.5.5",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
