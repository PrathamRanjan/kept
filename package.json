{
  "name": "kept",
  "version": "0.1.0",
  "private": true,
  "description": "Kept: PayPal subscriptions that AI agents can manage, with fair retention for small subscription businesses.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "worker": "node --env-file-if-exists=.env dist/worker-main.js",
    "cron": "node --env-file-if-exists=.env dist/cron-main.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "sandbox:check": "tsx --env-file-if-exists=.env scripts/sandbox-check.ts",
    "agent:demo": "tsx --env-file-if-exists=.env scripts/buyer-agent.ts",
    "webhook:register": "tsx --env-file-if-exists=.env scripts/register-webhook.ts",
    "eval:reasons": "tsx --env-file-if-exists=.env scripts/eval-reasons.ts",
    "eval:adversarial": "tsx --env-file-if-exists=.env scripts/eval-adversarial.ts",
    "cli": "tsx --env-file-if-exists=.env scripts/kept-cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
