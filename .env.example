# PayPal REST app (sandbox). Developer Dashboard > Apps & Credentials > Sandbox.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after `npm run sandbox:webhook` registers the webhook for APP_URL.
PAYPAL_WEBHOOK_ID=

# Public URL of this app (Render sets RENDER_EXTERNAL_URL automatically).
APP_URL=http://localhost:3000
PORT=3000

# Postgres. Leave empty to use embedded PGlite at ./data/pglite (local dev and tests).
DATABASE_URL=

# Signs owner session cookies and encrypts stored merchant credentials. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# "local" = deterministic rules brain (no model calls). "openai" = model brain for drafting, classification and
# wording, with the rules brain as fallback. Money never passes through a model either way.
KEPT_BRAIN=openai
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional model overrides (read / classify / vision tiers)
# OPENAI_MODEL_READ=gpt-5.5
# OPENAI_MODEL_CLASSIFY=gpt-5.4-mini
# OPENAI_MODEL_VISION=gpt-5.6-luna

# Guard: approvals above this amount (cents) need a passkey countersign once the owner has registered one.
KEPT_COUNTERSIGN_ABOVE_CENTS=20000

# Channels. Telegram webhook: ${APP_URL}/webhooks/telegram (secret header = TELEGRAM_WEBHOOK_SECRET).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Cloud API webhook: ${APP_URL}/webhooks/whatsapp (GET verify uses WHATSAPP_VERIFY_TOKEN).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=kept-verify
# Web push (PWA). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Log in with PayPal (needs a sandbox app with the feature enabled)
PAYPAL_LOGIN_ENABLED=false

# Alternative PGlite directory, e.g. for running evals while the dev server holds ./data/pglite
# PGLITE_PATH=./data/pglite-eval

# Demo helpers: one-click demo owner sign-in and the labelled "simulate failed payment" button.
KEPT_DEMO_MODE=true

# Run the background worker inside the web process (handy locally; on Render the worker runs separately).
KEPT_INLINE_WORKER=true
